# ==============================================================================
# BLACKBOXES ECOSYSTEM - CLOUDFLARE MANAGEMENT CONFIGURATION (.env)
# ==============================================================================
# This file is gitignored and contains private credentials for managing
# the BlackBoxes domain (blackboxes.net), subdomains, Cloudflare Pages,
# Workers, and DNS records autonomously.
# ==============================================================================

# 1. Cloudflare Dedicated API Token (Exclusively for BlackBoxes)
# Permissions Required:
#   - Zone.DNS:Edit
#   - Zone.Zone:Read
#   - Zone.SSL and Certificates:Edit
#   - Account.Cloudflare Pages:Edit
#   - Account.Workers:Edit
# Zone Resources:
#   - Include: Specific zone -> blackboxes.net
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 2. Cloudflare Account & Zone Details
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_ACCOUNT_EMAIL=your_email@example.com

# 3. Environment Mode
NODE_ENV=production
PORT=8080
