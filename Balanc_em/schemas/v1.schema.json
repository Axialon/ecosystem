{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackboxes.engine/schema/balancem/v1.json",
  "title": "Balanc'em Game Balance Configuration Schema",
  "type": "object",
  "required": ["version", "meta", "constraints", "submodules", "visuals"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "meta": {
      "type": "object",
      "required": ["brand", "app", "title", "archetype"],
      "properties": {
        "brand": { "type": "string", "const": "Blackboxes" },
        "app": { "type": "string", "const": "Balanc'em" },
        "title": { "type": "string", "maxLength": 100 },
        "archetype": { "type": "string" },
        "author": { "type": "string", "maxLength": 60 }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["damagePerSecondDps", "effectiveHealthPoolEhp", "resourceCostCooldown", "skillCeilingApm", "lockMode"],
      "properties": {
        "damagePerSecondDps": { "type": "number", "minimum": 10, "maximum": 5000 },
        "effectiveHealthPoolEhp": { "type": "number", "minimum": 100, "maximum": 50000 },
        "resourceCostCooldown": { "type": "number", "minimum": 5, "maximum": 200 },
        "skillCeilingApm": { "type": "number", "minimum": 20, "maximum": 400 },
        "lockMode": { "type": "string", "enum": ["dps", "ehp", "resource", "skill"] }
      }
    },
    "submodules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "powerScore"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "powerScore": { "type": "number" }
        }
      }
    },
    "visuals": {
      "type": "object",
      "required": ["shaderPreset", "theme"],
      "properties": {
        "shaderPreset": { "type": "string" },
        "theme": { "type": "string", "enum": ["dark", "light"] }
      }
    }
  }
}
