# ==============================================================================
# Blackboxes Box'em - Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Local Node.js Server Port (Default: 8080)
PORT=8080

# Environment Mode (development | test | production)
NODE_ENV=development

# Cloudflare Worker Webhook HMAC Secret (Used for verifying voluntary donation payloads)
# In production, set via: wrangler secret put HMAC_SECRET
HMAC_SECRET=your_hmac_sha256_secret_key_here

# Optional: Cloudflare D1 Database Binding Name
D1_DATABASE_NAME=boxem-db
